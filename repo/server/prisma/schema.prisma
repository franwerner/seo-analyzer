// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ValidationType {
  scheme
  semantic
  spelling
  resource
  structure
}

model VirtualWeb {
  id                Int                 @id @default(autoincrement())
  host              String              @unique
  createdAt         DateTime            @default(now())
  virtualDom        VirtualDom[]
  virtualWebConfig  VirtualWebConfig?
  virtualWebSummary VirtualWebSummary[]
}

model VirtualWebConfig {
  id               Int        @id @default(autoincrement())
  virtualWebId     Int        @unique
  mainVirtualDomId Int        @unique
  virtualWeb       VirtualWeb @relation(fields: [virtualWebId], references: [id])
  virtualDom       VirtualDom @relation(fields: [mainVirtualDomId], references: [id])
}

model VirtualWebSummary {
  id                     Int                     @id @default(autoincrement())
  content                String
  virtualWebId           Int
  createdAt              DateTime                @default(now())
  virtualWeb             VirtualWeb              @relation(fields: [virtualWebId], references: [id])
  virtualWebSummaryUsage VirtualWebSummaryUsage?
}

model VirtualDom {
  id               Int                  @id @default(autoincrement())
  virtualWebId     Int
  pathname         String
  createdAt        DateTime             @default(now())
  virtualWeb       VirtualWeb           @relation(fields: [virtualWebId], references: [id])
  analyses         VirtualDomAnalysis[]
  virtualWebConfig VirtualWebConfig?

  @@unique([virtualWebId, pathname])
}

model AIUsage {
  id                      Int                      @id @default(autoincrement())
  input                   Int
  output                  Int
  model                   String
  virtualDomAnalysisUsage VirtualDomAnalysisUsage?
  virtualWebSummaryUsage  VirtualWebSummaryUsage?
}

model VirtualWebSummaryUsage {
  id                  Int               @id @default(autoincrement())
  virtualWebSummaryId Int               @unique
  AIUsageId           Int               @unique
  virtualWebSummary   VirtualWebSummary @relation(fields: [virtualWebSummaryId], references: [id])
  AIUsage             AIUsage           @relation(fields: [AIUsageId], references: [id])
}

model VirtualDomAnalysis {
  id                      Int                      @id @default(autoincrement())
  virtualDomId            Int
  createdAt               DateTime                 @default(now())
  virtualDom              VirtualDom               @relation(fields: [virtualDomId], references: [id])
  analysisIssue           AnalysisIssue[]
  virtualDomAnalysisUsage VirtualDomAnalysisUsage?
}

model VirtualDomAnalysisUsage {
  id                   Int                @id @default(autoincrement())
  virtualDomAnalysisId Int                @unique
  AIUsageId            Int                @unique
  virtualDomAnalysis   VirtualDomAnalysis @relation(fields: [virtualDomAnalysisId], references: [id])
  AIUsage              AIUsage            @relation(fields: [AIUsageId], references: [id])
}

model AnalysisIssue {
  id                   Int                @id @default(autoincrement())
  virtualDomAnalysisId Int
  tag                  String
  message              String
  type                 ValidationType
  virtualDomAnalysis   VirtualDomAnalysis @relation(fields: [virtualDomAnalysisId], references: [id])
  issueTraceId         IssueTraceId[]
}

model IssueTraceId {
  id            Int           @id @default(autoincrement())
  issueId       Int
  traceId       String
  analysisIssue AnalysisIssue @relation(fields: [issueId], references: [id])

  @@unique([issueId, traceId])
}
